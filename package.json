{
  "name": "berzerk-inspired",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:sprint4": "node tests/run-all.mjs",
    "test:sprint5": "node tests/run-all.mjs --sprint5",
    "test:sprint6:config": "node --test tests/level-config.test.mjs",
    "test:sprint6:levels": "node tests/run-sprint-6-levels.mjs",
    "test:sprint6:difficulty": "node tests/run-sprint-6-levels.mjs --difficulty",
    "test:sprint6:progression": "node tests/run-sprint-7.mjs",
    "test:sprint6:hud": "node tests/run-sprint-7.mjs",
    "test:sprint6": "node tests/run-all.mjs --sprint7",
    "test:sprint7:unit": "node --test tests/level-config.test.mjs tests/waves.test.mjs tests/special-charge.test.mjs",
    "test:sprint7:integration": "node tests/run-sprint-7.mjs",
    "test:sprint7": "node tests/run-all.mjs --sprint7",
    "test:sprint8:unit": "node --test tests/level-config.test.mjs tests/waves.test.mjs tests/special-charge.test.mjs tests/environment.test.mjs",
    "test:sprint8:environment": "node tests/run-sprint-8.mjs",
    "test:sprint8:performance": "node tests/run-sprint-8-performance.mjs",
    "test:sprint8": "node tests/run-all.mjs --sprint8"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
