{
  "name": "berzerk-inspired",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:sprint4": "node tests/run-all.mjs",
    "test:sprint5": "node tests/run-all.mjs --sprint5",
    "test:sprint6:config": "node --test tests/level-config.test.mjs",
    "test:sprint6:levels": "node tests/run-sprint-6-levels.mjs",
    "test:sprint6:difficulty": "node tests/run-sprint-6-levels.mjs --difficulty",
    "test:sprint6:progression": "node tests/run-sprint-7.mjs",
    "test:sprint6:hud": "node tests/run-sprint-7.mjs",
    "test:sprint6": "node tests/run-all.mjs --sprint7",
    "test:sprint7:unit": "node --test tests/level-config.test.mjs tests/waves.test.mjs tests/special-charge.test.mjs",
    "test:sprint7:integration": "node tests/run-sprint-7.mjs",
    "test:sprint7": "node tests/run-all.mjs --sprint7",
    "test:sprint8:unit": "node --test tests/level-config.test.mjs tests/waves.test.mjs tests/special-charge.test.mjs tests/environment.test.mjs",
    "test:sprint8:environment": "node tests/run-sprint-8.mjs",
    "test:sprint8:performance": "node tests/run-sprint-8-performance.mjs",
    "test:sprint8": "node tests/run-all.mjs --sprint8",
    "test:sprint9:unit": "node --test tests/large-rooms.test.mjs tests/enemy-attacks.test.mjs tests/level-config.test.mjs tests/waves.test.mjs tests/special-charge.test.mjs tests/environment.test.mjs",
    "test:sprint9:attacks": "node tests/run-robot-attacks.mjs",
    "test:robot-lab": "node tests/run-robot-lab.mjs",
    "test:sprint9:rooms": "node tests/run-sprint-9.mjs",
    "test:sprint9:performance": "node tests/run-sprint-9-performance.mjs",
    "test:sprint9": "node tests/run-all.mjs --sprint9",
    "test:sprint10": "node tests/run-all.mjs --sprint10",
    "test:sprint10:maps": "node --test tests/map-composition.test.mjs tests/large-rooms.test.mjs",
    "test:sprint10:visual": "node tests/capture-sprint-10.mjs",
    "test:sprint10:performance": "node tests/run-sprint-9-performance.mjs --sprint10",
    "test:sprint11": "node tests/run-all.mjs --sprint11",
    "test:sprint11:unit": "node --test tests/quimera.test.mjs tests/enemy-attacks.test.mjs tests/level-config.test.mjs tests/waves.test.mjs tests/special-charge.test.mjs tests/environment.test.mjs tests/map-composition.test.mjs tests/large-rooms.test.mjs",
    "test:sprint11:boss": "node tests/run-sprint-11.mjs",
    "test:sprint11:visual": "node tests/capture-sprint-11.mjs",
    "test:finisher": "node --test tests/finisher.test.mjs && node tests/run-finisher.mjs",
    "test:sprint12": "node tests/run-sprint-12-all.mjs",
    "test:sprint12:unit": "node --test tests/*.test.mjs",
    "test:sprint12:campaign": "node tests/run-sprint-12.mjs",
    "test:sprint12:visual": "node tests/capture-sprint-12.mjs",
    "test:sprint12:performance": "node tests/run-sprint-12-performance.mjs",
    "test:sprint13": "node tests/run-sprint-12-all.mjs --sprint13",
    "test:sprint13:combat": "node tests/run-sprint-13.mjs",
